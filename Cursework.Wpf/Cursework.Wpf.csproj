<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Assets\Icon\app.ico" />
    <None Remove="Assets\Icon\chair.ico" />
    <None Remove="Assets\Icon\login.ico" />
    <None Remove="Assets\Images\Halls\main-hall.png" />
	<None Remove="Assets\Images\Halls\terrace.png" />
    <None Remove="Assets\Images\multi-seats.png" />
    <None Remove="Assets\Images\single-seats.png" />
	<None Update="appsettings.json">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cursework.Application\Cursework.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icon\app.ico" />
    <Resource Include="Assets\Icon\chair.ico" />
    <Resource Include="Assets\Icon\login.ico" />
    <Resource Include="Assets\Images\Halls\main-hall.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\Halls\terrace.png" />
    <Resource Include="Assets\Images\multi-seats.png" />
    <Resource Include="Assets\Images\single-seats.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ViewModels\Waiter\WaiterWindowViewModel.cs">
      <Generator>MSBuild:Compile</Generator>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <ApplicationIcon>Assets\Icon\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
