<Window x:Class="Cursework.Wpf.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:Cursework.Wpf.Views.Tabs"
        xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
        Title="Панель администратора" Width="1200" Height="720"
        Background="{StaticResource Brush.Background}"
        Icon="pack://application:,,,/Assets/Icon/app.ico">

    <Window.Resources>
        <conv:RoleDisplayConverter x:Key="RoleDisplay"/>
        <conv:TabHeaderToSubtitleConverter x:Key="TabSubtitle"/>
    </Window.Resources>

    <DockPanel Margin="16,4,16,16">
        <DockPanel Margin="16">
            <!-- Шапка -->
            <Border DockPanel.Dock="Top"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,0,12"
                    Background="White"
                    BorderBrush="#1A2B3340"
                    BorderThickness="1"
                    MinHeight="80">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть: название системы -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40"
                                CornerRadius="12"
                                Background="#FF2D7EF7"
                                VerticalAlignment="Center">
                            <TextBlock Text="ТК"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Управление кафе"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock FontSize="14"
                                       Opacity="0.8"
                                       Text="{Binding ElementName=MainTabs,
                                                      Path=SelectedItem.Header,
                                                      Converter={StaticResource TabSubtitle}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Правая часть: текущий сотрудник -->
                    <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding CurrentStaff.Name}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center" />

                        <Border Grid.Row="1"
                                CornerRadius="999"
                                Padding="8,2"
                                HorizontalAlignment="Center"
                                Background="#FFF3F4F7">
                            <TextBlock Text="{Binding CurrentStaff.Role, Converter={StaticResource RoleDisplay}}"
                                       FontSize="13"
                                       Opacity="0.8" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Вкладки -->
            <TabControl x:Name="MainTabs">
                <TabItem Header="Сотрудники">
                    <tabs:StaffTab/>
                </TabItem>

                <TabItem Header="Зал и столы">
                    <tabs:HallTablesTab x:Name="HallTab"/>
                </TabItem>

                <TabItem Header="Меню">
                    <tabs:MenuTab/>
                </TabItem>

                <TabItem Header="Заказы и оплаты">
                    <tabs:OrdersTab/>
                </TabItem>

                <TabItem Header="Вызовы официанта">
                    <tabs:CallWaiterTab/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
