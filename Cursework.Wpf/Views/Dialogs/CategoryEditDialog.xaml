<Window x:Class="Cursework.Wpf.Views.Dialogs.CategoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория блюда"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{StaticResource Brush.Background}">
	<Grid Margin="16">
		<Border Style="{StaticResource Card}"
                MinWidth="320">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Заголовок -->
				<StackPanel Grid.Row="0" Margin="0,0,0,16">
					<TextBlock Text="{Binding TitleText}"
                               Style="{StaticResource H2}"/>
					<TextBlock Text="Заполните данные категории блюда"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0"/>
				</StackPanel>

				<!-- Поле ввода -->
				<StackPanel Grid.Row="1" Orientation="Vertical">
					<TextBlock Text="Название категории"
                               Margin="0,0,0,4"/>
					<TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Base}"/>
				</StackPanel>

				<!-- Кнопки -->
				<StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
					<Button Content="Отмена"
                            Style="{StaticResource Button.Outline}"
                            MinWidth="90"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"/>
					<Button Content="Сохранить"
                            Style="{StaticResource Button.Base}"
                            MinWidth="90"
                            Click="Ok_Click"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
