<Window x:Class="Cursework.Wpf.Views.Dialogs.IngredientEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ингредиент"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{StaticResource Brush.Background}">
	<Grid Margin="16">
		<Border Style="{StaticResource Card}"
                MinWidth="380">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Заголовок -->
				<StackPanel Grid.Row="0" Margin="0,0,0,16">
					<TextBlock Text="{Binding TitleText}"
                               Style="{StaticResource H2}"/>
					<TextBlock Text="Заполните данные ингредиента"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0"/>
				</StackPanel>

				<!-- Название -->
				<StackPanel Grid.Row="1"
                            Orientation="Vertical"
                            Margin="0,0,0,10">
					<TextBlock Text="Название ингредиента"
                               Margin="0,0,0,4"/>
					<TextBox Text="{Binding IngredientName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Base}"/>
				</StackPanel>

				<!-- Категория -->
				<StackPanel Grid.Row="2"
                            Orientation="Vertical">
					<TextBlock Text="Категория ингредиента"
                               Margin="0,0,0,4"/>
					<ComboBox ItemsSource="{Binding CategoryIngredients}"
                              SelectedItem="{Binding SelectedCategoryIngredient, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ComboBox.Base}"/>
				</StackPanel>

				<!-- Кнопки -->
				<StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
					<Button Content="Отмена"
                            Style="{StaticResource Button.Outline}"
                            MinWidth="90"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"/>
					<Button Content="Сохранить"
                            Style="{StaticResource Button.Base}"
                            MinWidth="90"
                            Click="Ok_Click"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
