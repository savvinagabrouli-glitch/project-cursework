<Window x:Class="Cursework.Wpf.Views.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка пароля"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="16">
        <Border Style="{StaticResource Card}" Padding="20" MinWidth="420">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с иконкой -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="40" Height="40"
                            CornerRadius="20"
                            Background="{StaticResource Brush.Primary}">
                        <TextBlock Text="🔒"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Установка нового пароля"
                                   Style="{StaticResource H2}"/>
                        <TextBlock Text="Введите и подтвердите новый пароль для сотрудника"
                                   Style="{StaticResource Caption}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Поля ввода -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Новый пароль" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="pwd1"
                                 Style="{StaticResource PasswordBox.Base}"
                                 Width="260"/>

                    <TextBlock Text="Повторите пароль" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="pwd2"
                                 Style="{StaticResource PasswordBox.Base}"
                                 Width="260"/>
                </StackPanel>

                <!-- Подсказка -->
                <TextBlock Grid.Row="2"
                           Margin="0,12,0,0"
                           Style="{StaticResource Caption}">
                    Рекомендуется использовать не менее 8 символов, буквы и цифры.
                </TextBlock>

                <!-- Кнопки -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="Отмена"
                            Style="{StaticResource Button.Outline}"
                            Click="Cancel_Click"
                            FontSize="14"
                            Padding="16,8"/>

                    <Button Content="Сохранить пароль"
                            Style="{StaticResource Button.Base}"
                            Click="Ok_Click"
                            FontSize="14"
                            Padding="16,8"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
