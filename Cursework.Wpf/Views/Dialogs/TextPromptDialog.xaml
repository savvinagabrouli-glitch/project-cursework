<Window x:Class="Cursework.Wpf.Views.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}">
    <Border Style="{StaticResource Card}" Padding="16" Margin="16">
        <StackPanel Width="420">
            <TextBlock x:Name="MessageText" Text="Введите значение" TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox" Style="{StaticResource TextBox.Base}" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource Button.Outline}"
                        Width="100" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="OK" Style="{StaticResource Button.Outline}"
                        Width="100"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
