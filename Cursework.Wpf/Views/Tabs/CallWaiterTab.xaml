<UserControl x:Class="Cursework.Wpf.Views.Tabs.CallWaiterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
             xmlns:ctrl="clr-namespace:Cursework.Wpf.Views.Controls">

    <UserControl.Resources>
        <conv:BooleanNegationConverter x:Key="Not"/>
        <conv:CallWaiterTypeToTextConverter x:Key="CallWaiterTypeConverter"/>

        <!-- Тип вызова -->
        <x:Array x:Key="CallTypeFilterList" Type="{x:Type sys:String}">
            <sys:String>Все</sys:String>
            <sys:String>Вызов</sys:String>
            <sys:String>Принять предзаказ</sys:String>
        </x:Array>

        <x:Array x:Key="CallTypeEditList" Type="{x:Type sys:String}">
            <sys:String>Вызов</sys:String>
            <sys:String>Принять предзаказ</sys:String>
        </x:Array>

        <!-- Статус обработки -->
        <x:Array x:Key="HandledFilterList" Type="{x:Type sys:String}">
            <sys:String>Все</sys:String>
            <sys:String>Только обработанные</sys:String>
            <sys:String>Только необработанные</sys:String>
        </x:Array>

        <x:Array x:Key="HandledEditList" Type="{x:Type sys:String}">
            <sys:String>Не обработан</sys:String>
            <sys:String>Обработан</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВО: фильтры и поиск -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Фильтры"
                           Style="{StaticResource H2}"
                           Margin="0,0,0,8"/>

                <!-- Столы -->
                <TextBlock Text="Столы"
                           Margin="0,0,0,6"/>
                <ctrl:TableMultiSelector ItemsSource="{Binding Tables}"
                                         SelectedTableId="{Binding FilterTableId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,0,8"/>

                <Button Content="Показать все столы"
                                Style="{StaticResource Button.Outline}"
                                Command="{Binding ClearTableFilterCommand}"
                                Margin="0,0,0,8"
                                Padding="8,4"/>

                <!-- Тип вызова -->
                <TextBlock Text="Тип вызова"
                           Margin="0,8,0,6"/>
                <ComboBox ItemsSource="{StaticResource CallTypeFilterList}"
                          SelectedItem="{Binding FilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="50"
                          Style="{StaticResource ComboBox.Base}"/>

                <!-- Статус обработки -->
                <TextBlock Text="Статус обработки"
                           Margin="0,8,0,6"/>
                <ComboBox ItemsSource="{StaticResource HandledFilterList}"
                          SelectedItem="{Binding FilterHandled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Height="50"
                          Style="{StaticResource ComboBox.Base}"/>

                <!-- Даты -->
                <TextBlock Text="Создан"
                           Margin="0,12,0,6"/>
                <TextBox Text="{Binding CreatedAtFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="50"
                         Style="{StaticResource TextBox.Base}"/>

                <TextBlock Text="Взят"
                           Margin="0,8,0,6"/>
                <TextBox Text="{Binding HandledAtFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="50"
                         Style="{StaticResource TextBox.Base}"/>

                <TextBlock Text="Формат даты и времени: дд.мм.гггг чч:мм"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>

                <!-- Поиск по номеру заказа -->
                <TextBlock Text="Поиск"
                           Style="{StaticResource H2}"
                           Margin="0,16,0,8"/>
                <TextBlock Text="Номер заказа"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding SearchOrderIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="50"
                         Style="{StaticResource TextBox.Base}"/>

                <!-- Найдено -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="{Binding FilteredCount, StringFormat=Найдено: {0}}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ЦЕНТР: кнопки и таблица -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопки -->
			<StackPanel Orientation="Horizontal"
						Margin="0,0,0,12"
						Grid.Row="0">
				<Button Content="Добавить вызов официанту"
						Style="{StaticResource Button.Outline}"
						Command="{Binding AddCommand}"
						FontSize="14"
						Padding="16,10"/>

				<Button Content="Редактировать"
						Style="{StaticResource Button.Outline}"
						Command="{Binding EditCommand}"
						FontSize="14"
						Padding="16,10"
						Margin="8,0,0,0"/>

				<Button Content="Удалить вызов"
						Style="{StaticResource Button.Outline}"
						Command="{Binding DeleteCommand}"
						FontSize="14"
						Padding="16,10"
						Margin="8,0,0,0"/>
			</StackPanel>

			<!-- Таблица -->
            <Border Style="{StaticResource Card}"
                    Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,8">
                        <Run Text="Всего вызовов: "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    </TextBlock>

                    <DataGrid x:Name="CallWaitersGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding CallWaitersView}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="{Binding IsEditingGrid, Converter={StaticResource Not}}"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource Brush.Border}"
                              BorderThickness="1"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="CallWaitersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"
                                                Binding="{Binding Id}"
                                                Width="60"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Стол"
                                                Binding="{Binding Table.Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Номер заказа"
                                                Binding="{Binding OrderId}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Тип"
                                                Binding="{Binding Type, Converter={StaticResource CallWaiterTypeConverter}}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Создан"
                                                Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Взят"
                                                Binding="{Binding HandledAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                                Width="160"/>
                            <DataGridCheckBoxColumn Header="Обработан"
                                                    Binding="{Binding IsHandled}"
                                                    Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ПРАВО: форма вызова -->
        <Border Grid.Column="4"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Форма вызова"
                           Style="{StaticResource H2}"
                           Margin="0,0,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Номер -->
                        <RowDefinition Height="Auto"/>
                        <!-- Стол -->
                        <RowDefinition Height="Auto"/>
                        <!-- Номер заказа -->
                        <RowDefinition Height="Auto"/>
                        <!-- Создан -->
                        <RowDefinition Height="Auto"/>
                        <!-- Взят -->
                        <RowDefinition Height="Auto"/>
                        <!-- Подсказка по дате -->
                        <RowDefinition Height="Auto"/>
                        <!-- Тип -->
                        <RowDefinition Height="Auto"/>
                        <!-- Статус обработки -->
                    </Grid.RowDefinitions>

                    <!-- Номер -->
                    <TextBlock Text="Номер"
                               Grid.Row="0" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             IsReadOnly="True"
                             Style="{StaticResource TextBox.Base}"
                             Margin="0,0,0,8"
                             Text="{Binding EditItem.Id}"
                             Visibility="Collapsed"/>

                    <!-- Стол -->
                    <TextBlock Text="Стол"
                               Grid.Row="1" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"/>
                    <ctrl:TableMultiSelector Grid.Row="1" Grid.Column="1"
                                             ItemsSource="{Binding Tables}"
                                             SelectedTableId="{Binding EditItem.TableId, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditingGrid}"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,0,0,8"/>

                    <!-- Номер заказа -->
                    <TextBlock Text="Номер&#10;заказа"
                               Grid.Row="2" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding EditItem.OrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Base}"
                             IsEnabled="{Binding IsEditingGrid}"
                             Margin="0,0,0,8"
                             HorizontalAlignment="Stretch"/>

                    <!-- Создан -->
                    <TextBlock Text="Создан"
                               Grid.Row="3" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding CreatedAtInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Base}"
                             IsEnabled="{Binding IsEditingGrid}"
                             Margin="0,0,0,8"
                             HorizontalAlignment="Stretch"/>

                    <!-- Взят -->
                    <TextBlock Text="Взят"
                               Grid.Row="4" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding HandledAtInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox.Base}"
                             IsEnabled="{Binding IsEditingGrid}"
                             Margin="0,0,0,8"
                             HorizontalAlignment="Stretch"/>

                    <!-- Подсказка по формату дат -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="Формат даты и времени: дд.мм.гггг чч:мм"
                               HorizontalAlignment="Center"
                               Margin="0,0,-60,8"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>

                    <!-- Тип -->
                    <TextBlock Text="Тип"
                               Grid.Row="6" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="6" Grid.Column="1"
                              ItemsSource="{StaticResource CallTypeEditList}"
                              SelectedItem="{Binding EditingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ComboBox.Base}"
                              IsEnabled="{Binding IsEditingGrid}"
                              Height="50"
                              Margin="0,0,0,8"
                              HorizontalAlignment="Stretch"/>

                    <!-- Статус обработки -->
                    <TextBlock Text="Статус&#10;обработки"
                               Grid.Row="7" Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <ComboBox Grid.Row="7" Grid.Column="1"
                              ItemsSource="{StaticResource HandledEditList}"
                              SelectedItem="{Binding EditingHandledStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ComboBox.Base}"
                              IsEnabled="{Binding IsEditingGrid}"
                              Height="50"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Отменить"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding CancelCommand}"
                            FontSize="14"
                            Padding="16,10"/>
                    <Button Content="Сохранить"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding SaveCommand}"
                            FontSize="14"
                            Padding="16,10"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
