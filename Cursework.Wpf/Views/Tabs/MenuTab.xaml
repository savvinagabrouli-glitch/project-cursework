<UserControl x:Class="Cursework.Wpf.Views.Tabs.MenuTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <conv:BooleanNegationConverter x:Key="Not"/>

        <!-- Заголовок карточки -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource H3}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Background}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2.8*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ВЕРХНИЙ РЯД: три карточки на одной линии ===== -->

        <!-- 1) Категории блюд -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Категории блюд"
                           Style="{StaticResource CardTitle}"
                           Margin="0,0,0,8"/>

                <!-- Верхние кнопки -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8">
                    <Button Content="Добавить"
                            Click="CategoryAdd_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanCategoryAdd}"/>

                    <Button Content="Редактировать"
                            Click="CategoryEdit_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanCategoryEdit}"/>

                    <Button Content="Удалить"
                            Click="CategoryDelete_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            IsEnabled="{Binding CanCategoryDelete}"/>
                </StackPanel>

                <!-- Список категорий (фильтр для блюд) -->
                <ListBox Grid.Row="1" Grid.ColumnSpan="2"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 2) Блюда -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Блюда"
                           Style="{StaticResource CardTitle}"
                           Margin="0,0,0,8"/>

                <!-- Кнопки сверху -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8">
                    <Button Content="Добавить"
                            Command="{Binding DishAddCommand}"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanDishAdd}"/>
                    <Button Content="Редактировать"
                            Command="{Binding DishBeginEditCommand}"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanDishEdit}"/>
                    <Button Content="Удалить"
                            Command="{Binding DishDeleteCommand}"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanDishDelete}"/>
                    <Button Content="Показать все"
                            Command="{Binding DishShowAllCommand}"
                            FontSize="14"
                            Style="{StaticResource Button.Outline}"/>
                </StackPanel>


                <!-- Таблица блюд -->
                <DataGrid Grid.Row="1" Grid.ColumnSpan="2"
                          ItemsSource="{Binding Dishes}"
                          SelectedItem="{Binding SelectedDish, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=F2}" Width="110"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="160" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 3) Ингредиенты -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Ингредиенты"
                           Style="{StaticResource CardTitle}"
                           Margin="0,0,0,8"/>

                <!-- Кнопки сверху -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8">
                    <Button Content="Добавить"
                            Click="IngredientAdd_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanIngredientAdd}"/>

                    <Button Content="Редактировать"
                            Click="IngredientEdit_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanIngredientEdit}"/>

                    <Button Content="Удалить"
                            Command="{Binding IngredientDeleteCommand}"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanIngredientDelete}"/>

                    <Button Content="Показать все"
                            Command="{Binding IngredientShowAllCommand}"
                            FontSize="14"
                            Style="{StaticResource Button.Outline}"/>
                </StackPanel>

                <!-- Таблица ингредиентов -->
                <DataGrid Grid.Row="1" Grid.ColumnSpan="2"
                          ItemsSource="{Binding Ingredients}"
                          SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="{Binding IsEditingIngredient, Converter={StaticResource Not}}"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Категория"
                                            Binding="{Binding CategoryIngredient.Name}"
                                            Width="160"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== НИЖНИЙ РЯД ===== -->

        <!-- Категории ингредиентов снизу слева -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,16,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- заголовок + верхние кнопки -->
                    <RowDefinition Height="Auto"/>
                    <!-- список со скроллом -->
                    <RowDefinition Height="*"/>
                    <!-- нижние кнопки -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Категории ингредиентов"
                           Style="{StaticResource CardTitle}"
                           Margin="0,0,0,8"/>

                <!-- Верхние кнопки -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" 
                            Margin="0,0,0,8">
                    <Button Content="Добавить"
                            Click="CatIngredientAdd_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Height="26"
                            VerticalAlignment="Top"
                            Margin="0,8,4,0"
                            IsEnabled="{Binding CanCatIngAdd}"/>

                    <Button Content="Редактировать"
                            Click="CatIngredientEdit_Click"
                            Style="{StaticResource Button.Outline}"
                            FontSize="14"
                            Height="26"
                            VerticalAlignment="Top"
                            Margin="0,8,4,0"
                            IsEnabled="{Binding CanCatIngEdit}"/>

                    <Button Content="Удалить"
                            Click="CatIngredientDelete_Click"
                            FontSize="14"
                            Height="26"
                            VerticalAlignment="Top"
                            Style="{StaticResource Button.Outline}"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding CanCatIngDelete}"/>
                </StackPanel>

                <!-- Список категорий ингредиентов (фильтр для ингредиентов) -->
                <ListBox Grid.Row="1" Grid.ColumnSpan="2"
                         ItemsSource="{Binding CategoryIngredients}"
                         SelectedItem="{Binding SelectedCategoryIngredient, Mode=TwoWay}"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Форма блюда: поля слева, предпросмотр справа -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Форма блюда"
                           Style="{StaticResource H2}"
                           Margin="0,0,0,12"/>

                <!-- Левая часть: все поля -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Название -->
                        <RowDefinition Height="*"/>
                        <!-- Описание -->
                        <RowDefinition Height="Auto"/>
                        <!-- Цена + Категория -->
                        <RowDefinition Height="Auto"/>
                        <!-- Фото -->
                    </Grid.RowDefinitions>

                    <!-- Название -->
                    <StackPanel Grid.Row="0"
                                Orientation="Vertical"
                                Margin="0,0,0,8">
                        <TextBlock Text="Название" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedDish.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Base}"
                                 IsReadOnly="{Binding IsEditingDish, Converter={StaticResource Not}}"/>
                    </StackPanel>

                    <!-- Описание -->
                    <StackPanel Grid.Row="1"
                                Orientation="Vertical"
                                Margin="0,0,0,8">
                        <TextBlock Text="Описание" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedDish.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Base}"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="{Binding IsEditingDish, Converter={StaticResource Not}}"/>
                    </StackPanel>

                    <!-- Цена + Категория -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    Margin="0,0,16,0">
                            <TextBlock Text="Цена" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedDish.Price, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                     Style="{StaticResource TextBox.Base}"
                                     IsReadOnly="{Binding IsEditingDish, Converter={StaticResource Not}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical">
                            <TextBlock Text="Категория блюда" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedDish.CategoryId, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Height="50"
                                      Style="{StaticResource ComboBox.Base}"
                                      IsEnabled="{Binding IsEditingDish}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Фото (URL или файл) -->
                    <StackPanel Grid.Row="3"
                                Orientation="Vertical">
                        <TextBlock Text="Фото (URL или файл)" Margin="0,0,0,4"/>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Left"
                                     Text="{Binding SelectedDish.PhotoUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Base}"
                                     Width="450"
                                     IsReadOnly="{Binding IsEditingDish, Converter={StaticResource Not}}"/>
                            <Button DockPanel.Dock="Right"
                                    Content="Выбрать фото"
                                    Style="{StaticResource Button.Outline}"
                                    FontSize="14"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding IsEditingDish}"
                                    Click="SelectPhoto_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Правая часть: крупный предпросмотр -->
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Предпросмотр" Margin="0,0,0,4"/>
                    <Border BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.M}"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            MinHeight="180"
                            Height="315">
                        <Image Source="{Binding SelectedDish.PhotoUrl}"
                               Stretch="Uniform"
                               Margin="6"/>
                    </Border>
                </StackPanel>

                <!-- Кнопки внизу -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Отменить"
                            FontSize="14"
                            Command="{Binding DishCancelCommand}"
                            Style="{StaticResource Button.Outline}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanDishCancel}"/>
                    <Button Content="Сохранить"
                            FontSize="14"
                            Command="{Binding DishSaveCommand}"
                            Style="{StaticResource Button.Outline}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanDishSave}"/>
                    <Button Content="Состав блюда"
                            FontSize="14"
                            Style="{StaticResource Button.Outline}"
                            Click="DishComposition_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
