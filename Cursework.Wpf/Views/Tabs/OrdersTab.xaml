<UserControl x:Class="Cursework.Wpf.Views.Tabs.OrdersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
             xmlns:ctrl="clr-namespace:Cursework.Wpf.Views.Controls">
    <UserControl.Resources>
        <conv:BooleanNegationConverter x:Key="Not"/>
        <conv:OrderStatusToRussianConverter x:Key="OrderStatusToRu"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ========= ЛЕВО: ФИЛЬТРЫ + ПОИСК ========= -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Фильтры"
                           Style="{StaticResource H2}"
                           Margin="0,0,0,8"/>

                <!-- Фильтр по статусу -->
                <TextBlock Text="Статус"
                           Margin="0,0,0,6"/>
                <ComboBox Height="50"
                          Style="{StaticResource ComboBox.Base}"
                          ItemsSource="{Binding StatusFilterOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedStatusFilterCode, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Диапазон дат -->
                <TextBlock Text="Диапазон дат"
                           Margin="0,12,0,4"/>
                <TextBlock Text="Пример: 01-01-2025 или 01-01-2025:01-02-2025"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBox Height="50"
                         Style="{StaticResource TextBox.Base}"
                         Text="{Binding DateRangeFilterText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Поиск -->
                <TextBlock Text="Поиск"
                           Style="{StaticResource H2}"
                           Margin="0,16,0,8"/>

                <TextBlock Text="Номер, стол или официант"
                           Margin="0,0,0,4"/>

                <TextBox Height="50"
                         Style="{StaticResource TextBox.Base}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding FilteredCount, StringFormat=Найдено: {0}}"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource Brush.TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- ========= ЦЕНТР: КНОПКИ + ТАБЛИЦА ========= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12"
                        Grid.Row="0">
                <Button Content="Добавить заказ"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding AddCommand}"
                        FontSize="14"
                        Padding="16,10"/>

                <Button Content="Редактировать"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding EditCommand}"
                        FontSize="14"
                        Padding="16,10"
                        Margin="8,0,0,0"/>

                <Button Content="Удалить заказ"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding DeleteCommand}"
                        FontSize="14"
                        Padding="16,10"
                        Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Таблица в карточке -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}">
                <DataGrid x:Name="OrdersGrid"
                          ItemsSource="{Binding OrdersView}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="{Binding IsEditingGrid, Converter={StaticResource Not}}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="OrdersGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№"
                                            Binding="{Binding Id}"
                                            Width="60"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="Стол"
                                            Binding="{Binding Table.Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Официант"
                                            Binding="{Binding Waiter.Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status, Converter={StaticResource OrderStatusToRu}}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Создан"
                                            Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Закрыт"
                                            Binding="{Binding ClosedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                            Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ========= ПРАВО: ФОРМА ЗАКАЗА ========= -->
        <Border Grid.Column="4"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Форма заказа"
                           Style="{StaticResource H2}"
                           Margin="0,0,0,12"/>

                <!-- Форма -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Стол -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Официант -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Статус -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Создан -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Подсказка по формату -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: Закрыт -->
                    </Grid.RowDefinitions>

                    <!-- Стол -->
                    <TextBlock Text="Стол"
                               Grid.Row="0" Grid.Column="0"
                               Margin="0,0,8,4"
                               VerticalAlignment="Center"/>
                    <ctrl:TableMultiSelector Grid.Row="0" Grid.Column="1"
                                             ItemsSource="{Binding Tables}"
                                             SelectedTableId="{Binding EditingOrder.TableId, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditingGrid}"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,0,0,4"/>

                    <!-- Официант -->
                    <TextBlock Text="Официант"
                               Grid.Row="1" Grid.Column="0"
                               Margin="0,4,8,4"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Style="{StaticResource ComboBox.Base}"
                              ItemsSource="{Binding Waiters}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding EditingOrder.WaiterId, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditingGrid}"
                              Height="50"
                              HorizontalAlignment="Stretch"
                              Margin="0,4,0,4"/>

                    <!-- Статус -->
                    <TextBlock Text="Статус"
                               Grid.Row="2" Grid.Column="0"
                               Margin="0,4,8,4"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              Style="{StaticResource ComboBox.Base}"
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding EditingOrder.Status, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditingGrid}"
                              Height="50"
                              HorizontalAlignment="Stretch"
                              Margin="0,4,0,4"/>

                    <!-- Создан -->
                    <TextBlock Text="Создан"
                               Grid.Row="3" Grid.Column="0"
                               Margin="0,4,8,4"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource TextBox.Base}"
                             Text="{Binding CreatedAtInput, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditingGrid}"
                             HorizontalAlignment="Stretch"
                             Margin="0,4,0,4"/>

                    <!-- Подсказка по формату дат (одна на оба поля) -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="Формат даты и времени: дд.мм.гггг чч:мм"
                               HorizontalAlignment="Center"
                               Margin="0,0,-60,4"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>

                    <!-- Закрыт -->
                    <TextBlock Text="Закрыт"
                               Grid.Row="5" Grid.Column="0"
                               Margin="0,4,8,0"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Style="{StaticResource TextBox.Base}"
                             Text="{Binding ClosedAtInput, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditingGrid}"
                             HorizontalAlignment="Stretch"
                             Margin="0,4,0,0"/>
                </Grid>


                <!-- Кнопки -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Отменить"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding CancelCommand}"
                            FontSize="14"
                            Padding="16,10"/>

                    <Button Content="Сохранить"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding SaveCommand}"
                            FontSize="14"
                            Padding="16,10"
                            Margin="8,0,0,0"/>

                    <Button Content="Детали заказа"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding ShowDetailsCommand}"
                            FontSize="14"
                            Padding="16,10"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
