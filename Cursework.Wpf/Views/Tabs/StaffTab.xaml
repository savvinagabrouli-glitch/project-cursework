<UserControl x:Class="Cursework.Wpf.Views.Tabs.StaffTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:Cursework.Wpf.Converters">

    <UserControl.Resources>
        <conv:BooleanNegationConverter x:Key="Not"/>
        <conv:RoleDisplayConverter x:Key="RoleDisplay"/>
        <conv:IdFromCountConverter x:Key="IdFromCount"/>

        <!-- Список ролей для фильтра (с "Все") -->
        <x:Array x:Key="RolesFilterList" Type="{x:Type sys:String}">
            <sys:String>Все</sys:String>
            <sys:String>Администратор</sys:String>
            <sys:String>Официант</sys:String>
        </x:Array>

        <!-- Список ролей для редактирования (без "Все") -->
        <x:Array x:Key="RolesEditList" Type="{x:Type sys:String}">
            <sys:String>Администратор</sys:String>
            <sys:String>Официант</sys:String>
        </x:Array>
    </UserControl.Resources>

    <!-- Без отступа слева, чтобы карточка совпадала с TabItem -->
    <Grid Background="{StaticResource Brush.Background}" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВО: фильтры, поиск, найдено -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Фильтры" Style="{StaticResource H2}" Margin="0,0,0,8"/>

                <TextBlock Text="Роль" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{StaticResource RolesFilterList}"
                          Height="50"
                          SelectedItem="{Binding FilterRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ComboBox.Base}" />

                <TextBlock Text="Поиск" Style="{StaticResource H2}" Margin="0,16,0,8"/>
                <TextBlock Text="Номер, имя или логин" Margin="0,0,0,6"/>
                <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBox.Base}" />

                <!-- Только "Найдено" -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="{Binding FilteredCount, StringFormat=Найдено: {0}}"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource Brush.TextMuted}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ЦЕНТР: кнопки и таблица -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- кнопки -->
                <RowDefinition Height="*"/>
                <!-- таблица со скроллом -->
            </Grid.RowDefinitions>

            <!-- Кнопки: крупнее текст, видно активность по IsEnabled -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="0">
                <Button Content="Добавить сотрудника"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding AddCommand}"
                        FontSize="14"
                        Padding="16,10"/>

                <Button Content="Редактировать"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding EditCommand}"
                        IsEnabled="{Binding CanEdit}"
                        FontSize="14"
                        Padding="16,10"
                        Margin="8,0,0,0"/>

                <Button Content="Удалить сотрудника"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}"
                        FontSize="14"
                        Padding="16,10"
                        Margin="8,0,0,0"/>

                <Button Content="Сбросить пароль"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding ResetPasswordCommand}"
                        FontSize="14"
                        Padding="16,10"
                        Margin="8,0,0,0"/>
            </StackPanel>


            <!-- Таблица -->
            <Border Style="{StaticResource Card}" Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                       Style="{StaticResource Caption}"
                       Margin="0,0,0,8">
                        <Run Text="Всего сотрудников: "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    </TextBlock>

                    <DataGrid x:Name="StaffGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding StaffView}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="{Binding IsEditingGrid, Converter={StaticResource Not}}"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" IsReadOnly="True" Width="60">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource IdFromCount}" Mode="OneWay">
                                        <Binding Path="Id" />
                                        <Binding Path="DataContext.MaxId"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"
                                                 Mode="OneWay"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ФИО"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="Логин"
                                                Binding="{Binding Login}"
                                                Width="*" />

                            <!-- Роль: только Администратор / Официант, с конвертером -->
                            <DataGridComboBoxColumn Header="Роль"
                                                    Width="160"
                                                    ItemsSource="{StaticResource RolesEditList}"
                                                    SelectedItemBinding="{Binding Role,
                                                        Mode=TwoWay,
                                                        Converter={StaticResource RoleDisplay}}">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{StaticResource RolesEditList}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Base}">
                                        <Setter Property="ItemsSource" Value="{StaticResource RolesEditList}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ПРАВО: форма сотрудника (только валидные роли) -->
        <Border Grid.Column="4"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Форма сотрудника"
                           Style="{StaticResource H2}"
                           Margin="0,0,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Номер"
                           Grid.Row="0" Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True"
                         Style="{StaticResource TextBox.Base}"
                         Margin="0,0,0,8"
                         Visibility="Collapsed">
                        <TextBox.Text>
                            <MultiBinding Converter="{StaticResource IdFromCount}" Mode="OneWay">
                                <Binding Path="EditItem.Id" />
                                <Binding Path="DataContext.MaxId"
                     RelativeSource="{RelativeSource AncestorType=UserControl}"
                     Mode="OneWay"/>
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>


                    <TextBlock Text="ФИО"
                               Grid.Row="1" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"/>

                    <TextBox   Text="{Binding EditItem.Name, UpdateSourceTrigger=PropertyChanged}"
                               Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource TextBox.Base}"
                               Margin="0,0,0,8"
                               IsReadOnly="{Binding IsEditingGrid, Converter={StaticResource Not}}"/>

                    <TextBlock Text="Логин"
                               Grid.Row="2" Grid.Column="0"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"/>
                    <TextBox   Text="{Binding EditItem.Login, UpdateSourceTrigger=PropertyChanged}"
                               Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource TextBox.Base}"
                               Margin="0,0,0,8"
                               IsReadOnly="{Binding IsEditingGrid, Converter={StaticResource Not}}"/>

                    <TextBlock Text="Роль"
                               Grid.Row="3" Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1"
                               ItemsSource="{StaticResource RolesEditList}"
                               SelectedItem="{Binding EditItem.Role,
                                   Mode=TwoWay,
                                   Converter={StaticResource RoleDisplay}}"
                               Style="{StaticResource ComboBox.Base}"
                               Height="50"
                               IsEnabled="{Binding IsEditingGrid}"/>

                </Grid>

                <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                    <Button Content="Отменить"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding CancelCommand}"
                        FontSize="14"
                        Padding="16,10"/>
                    <Button Content="Сохранить"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding SaveCommand}"
                        FontSize="14"
                        Padding="16,10"
                        Margin="8,0,0,0"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>