<!-- Project/Cursework.Wpf/Views/Waiter/WaiterWindow.xaml -->
<Window x:Class="Cursework.Wpf.Views.Waiter.WaiterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cursework.Wpf.Views.Controls"
        xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
        Title="Рабочее место официанта"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <conv:StatusToRussianConverter x:Key="StatusToRu"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header: зона + уведомления -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <!-- контент -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- карта -->
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="380"/>
            <!-- панель управления столом -->
        </Grid.ColumnDefinitions>

        <!-- HEADER: зона + переключение + уведомления -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Текущая зона + круговое переключение -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedZoneTitle}"
                           Style="{StaticResource H1}"/>

                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="◀"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding PrevZoneCommand}"/>

                    <Button Content="▶"
                            Width="36"
                            Height="36"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding NextZoneCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Кнопка уведомлений справа -->
            <Grid Grid.Column="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <Button Width="40"
                        Height="40"
                        Padding="0"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding ToggleNotificationsCommand}">
                    <Grid>
                        <TextBlock Text="🔔"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- badge с количеством -->
                        <Border CornerRadius="10"
                                Padding="3,0"
                                Background="{StaticResource Brush.Danger}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                            <TextBlock Text="{Binding UnreadNotificationsCount}"
                                       Foreground="White"
                                       FontSize="10"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Панель уведомлений (выпадающая) -->
                <Border Grid.Row="0"
                        Margin="0,44,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="340"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Уведомления"
                                   Style="{StaticResource H3}"/>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Notifications}"
                                 SelectedItem="{Binding SelectedNotification}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,4"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:G}}"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- MAP (основная область) -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- zoom -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <!-- карта -->
                </Grid.RowDefinitions>

                <!-- Zoom-контрол -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Масштаб"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                    <Slider Margin="8,0,0,0"
                            Width="180"
                            Minimum="0.6"
                            Maximum="2.5"
                            Value="{Binding Zoom}"/>
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0:F2}x}"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Карта с зонами -->
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <Grid MinWidth="900"
                          MinHeight="650"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Zoom}"
                                            ScaleY="{Binding Zoom}"/>
                        </Grid.LayoutTransform>

                        <!-- Переключение зон по SelectedZone -->
                        <Grid>

                            <!-- MainHall -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedZone}" Value="MainHall">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/main-hall.png"
                                                             ItemsSource="{Binding TablesOnMap}"
                                                             SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                             Zoom="{Binding Zoom}"
                                                             IsDragEnabled="False"/>
                            </Grid>

                            <!-- Terrace -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedZone}" Value="Terrace">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/terrace.png"
                                                             ItemsSource="{Binding TablesOnMap}"
                                                             SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                             Zoom="{Binding Zoom}"
                                                             IsDragEnabled="False"/>
                            </Grid>

                            <!-- Bar (заглушка) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedZone}" Value="Bar">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid>
                                    <controls:HallMapZoneControl ItemsSource="{Binding TablesOnMap}"
                                                                 SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                                 Zoom="{Binding Zoom}"
                                                                 IsDragEnabled="False"/>
                                    <Border Background="#80000000"
                                            CornerRadius="24"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock Text="Схема в разработке"
                                                   Foreground="{StaticResource Brush.Accent}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- VIP (заглушка) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedZone}" Value="VIP">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid>
                                    <controls:HallMapZoneControl ItemsSource="{Binding TablesOnMap}"
                                                                 SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                                 Zoom="{Binding Zoom}"
                                                                 IsDragEnabled="False"/>
                                    <Border Background="#80000000"
                                            CornerRadius="24"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <TextBlock Text="Схема в разработке"
                                                   Foreground="{StaticResource Brush.Accent}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>

                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- RIGHT: панель управления столом -->
        <Border Grid.Row="2" Grid.Column="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Text="Стол"
                           Style="{StaticResource H3}"/>

                <!-- Краткая информация о выбранном столе -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding SelectedTableOnMap.TableName, TargetNullValue='Стол не выбран'}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <TextBlock Text="Мест: "
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding SelectedTableOnMap.Seats}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                        <TextBlock Text="Статус: "
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding SelectedTableOnMap.Status,
                                                  Converter={StaticResource StatusToRu}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Действия по заказу -->
                <StackPanel Grid.Row="4"
                            VerticalAlignment="Stretch">
                    <TextBlock Text="Действия"
                               Style="{StaticResource H3}"/>

                    <StackPanel Margin="0,8,0,0">
                        <Button Content="Открыть / показать заказ"
                                Margin="0,0,0,6"
                                Style="{StaticResource Button.Outline}"
                                Command="{Binding OpenOrderCommand}"
                                IsEnabled="{Binding HasSelectedTable}"/>

                        <Button Content="Отметить блюда как поданные"
                                Margin="0,0,0,6"
                                Style="{StaticResource Button.Outline}"
                                Command="{Binding MarkItemsServedCommand}"
                                IsEnabled="{Binding HasSelectedTable}"/>

                        <Button Content="Закрыть заказ"
                                Style="{StaticResource Button.Danger}"
                                Command="{Binding CloseOrderCommand}"
                                IsEnabled="{Binding HasSelectedTable}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>