<!-- Project/Cursework.Wpf/Views/Waiter/WaiterWindow.xaml -->
<Window x:Class="Cursework.Wpf.Views.Waiter.WaiterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cursework.Wpf.Views.Controls"
        xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
        Title="Рабочее место официанта"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <conv:StatusToRussianConverter x:Key="StatusToRu"/>
        <conv:OrderItemStatusToRussianConverter x:Key="OrderItemStatusToRu"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:HalfValueConverter x:Key="HalfValue"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="TextToVisibility"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: зона + переключение + уведомления -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Текущая зона + круговое переключение -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedZoneTitle}"
                           Style="{StaticResource H1}"/>

                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="◀"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding PrevZoneCommand}"/>

                    <Button Content="▶"
                            Width="36"
                            Height="36"
                            Style="{StaticResource Button.Outline}"
                            Command="{Binding NextZoneCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Кнопка уведомлений справа -->
            <Grid Grid.Column="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <Button Width="44"
                        Height="44"
                        Padding="0"
                        Style="{StaticResource Button.Outline}"
                        Command="{Binding ToggleNotificationsCommand}">
                    <Grid>
                        <TextBlock Text="🔔"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Border CornerRadius="10"
                                Padding="3,0"
                                Background="{StaticResource Brush.Danger}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnreadNotificationsCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UnreadNotificationsCount}">
                                            <DataTrigger.Value>
                                                <x:Null />
                                            </DataTrigger.Value>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding UnreadNotificationsCount}"
                                       Foreground="White"
                                       FontSize="10"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Панель уведомлений -->
                <Border Grid.Row="0"
                        Panel.ZIndex="20"
                        Margin="0,48,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="360"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12"
                        Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Уведомления"
                                       Style="{StaticResource H3}"/>
                            <Button Content="Обновить"
                                    Style="{StaticResource Button.Outline}"
                                    Margin="8,0,0,0"
                                    Command="{Binding RefreshNotificationsCommand}"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding Notifications}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Grid>
                                        <ItemsPresenter />
                                        <TextBlock Text="Нет новых вызовов"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </ItemsControl.Template>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Margin="0,0,0,8"
                                            Background="{StaticResource Brush.SurfaceAlt}"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <Button Content="{Binding TableName}"
                                                    Style="{StaticResource Button.Link}"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Message}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:G}}"
                                                       Foreground="{StaticResource Brush.TextMuted}"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8">
                                                <Button Content="Принять"
                                                        Style="{StaticResource Button.Outline}"
                                                        Command="{Binding DataContext.AcceptNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- MAP (основная область) -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Zoom-контрол -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Масштаб"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <Slider Margin="8,0,0,0"
                                Width="180"
                                Minimum="0.6"
                                Maximum="2.5"
                                Value="{Binding Zoom}"/>
                        <TextBlock Text="{Binding Zoom, StringFormat={}{0:F2}x}"
                                   Margin="10,0,0,0"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Карта с зонами -->
                    <Grid Grid.Row="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent">
                            <Grid x:Name="MapContainer"
                                  MinWidth="900"
                                  MinHeight="650"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding Zoom}"
                                                    ScaleY="{Binding Zoom}"
                                                    CenterX="{Binding ActualWidth, ElementName=MapContainer, Converter={StaticResource HalfValue}}"
                                                    CenterY="{Binding ActualHeight, ElementName=MapContainer, Converter={StaticResource HalfValue}}"/>
                                </Grid.LayoutTransform>

                                <Grid>
                                    <!-- MainHall -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedZone}" Value="MainHall">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/main-hall.png"
                                                                     ItemsSource="{Binding TablesOnMap}"
                                                                     SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                                     Zoom="{Binding Zoom}"
                                                                     IsDragEnabled="False"
                                                                     IsReadOnly="True"/>
                                    </Grid>

                                    <!-- Terrace -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedZone}" Value="Terrace">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/terrace.png"
                                                                     ItemsSource="{Binding TablesOnMap}"
                                                                     SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                                     Zoom="{Binding Zoom}"
                                                                     IsDragEnabled="False"
                                                                     IsReadOnly="True"/>
                                    </Grid>

                                    <!-- Bar (заглушка) -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedZone}" Value="Bar">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid>
                                            <controls:HallMapZoneControl ItemsSource="{Binding TablesOnMap}"
                                                                         SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                                         Zoom="{Binding Zoom}"
                                                                         IsDragEnabled="False"
                                                                         IsReadOnly="True"/>
                                            <Border Background="#80000000"
                                                    CornerRadius="24"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="Схема в разработке"
                                                           Foreground="{StaticResource Brush.Accent}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- VIP (заглушка) -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedZone}" Value="VIP">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid>
                                            <controls:HallMapZoneControl ItemsSource="{Binding TablesOnMap}"
                                                                         SelectedItem="{Binding SelectedTableOnMap, Mode=TwoWay}"
                                                                         Zoom="{Binding Zoom}"
                                                                         IsDragEnabled="False"
                                                                         IsReadOnly="True"/>
                                            <Border Background="#80000000"
                                                    CornerRadius="24"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="Схема в разработке"
                                                           Foreground="{StaticResource Brush.Accent}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <Border Background="#CCFFFFFF"
                                CornerRadius="16"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                Padding="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding LayoutMessage, Converter={StaticResource TextToVisibility}}">
                            <TextBlock Text="{Binding LayoutMessage}"
                                       Style="{StaticResource H3}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: панель управления столом -->
            <Border Grid.Column="2"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Text="Стол"
                               Style="{StaticResource H3}"/>

                    <!-- Краткая информация о выбранном столе -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding SelectedTableOnMap.TableName, TargetNullValue='Стол не выбран'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0">
                            <TextBlock Text="Мест: "
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding SelectedTableOnMap.Seats}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,0,0">
                            <TextBlock Text="Статус: "
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding SelectedTableOnMap.Status, Converter={StaticResource StatusToRu}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,0,0">
                            <TextBlock Text="Зона: "
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding SelectedZoneTitle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Активный заказ -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Активный заказ"
                                   Style="{StaticResource H3}"/>

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasActiveOrder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ActiveOrderId, StringFormat=Заказ #{0}}"
                                       FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Статус:" Margin="0,0,6,0"/>
                                <ComboBox Width="180"
                                          ItemsSource="{Binding OrderStatusOptions}"
                                          SelectedItem="{Binding ActiveOrderStatus, Mode=TwoWay}"/>
                                <Button Content="Сохранить"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource Button.Outline}"
                                        Command="{Binding SaveOrderStatusCommand}"/>
                                <Button Content="Обновить"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource Button.Outline}"
                                        Command="{Binding RefreshOrderCommand}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ActiveOrderTotal, StringFormat=Сумма: {0:C}}"
                                       Foreground="{StaticResource Brush.TextMuted}"/>

                            <Border Margin="0,10,0,0"
                                    Background="{StaticResource Brush.SurfaceAlt}"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Позиции"
                                               FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding ActiveOrderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8"
                                                        Margin="0,4,0,4"
                                                        Background="{StaticResource Brush.Surface}"
                                                        CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DishName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat=Количество: {0}}"
                                                                   Foreground="{StaticResource Brush.TextMuted}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="Статус:" Margin="0,0,6,0"/>
                                                            <ComboBox Width="150"
                                                                      ItemsSource="{Binding DataContext.OrderItemStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding Status, Mode=TwoWay}"/>
                                                            <Button Content="Сохранить"
                                                                    Margin="8,0,0,0"
                                                                    Style="{StaticResource Button.Outline}"
                                                                    Command="{Binding DataContext.UpdateItemStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Notes}"
                                                                   Foreground="{StaticResource Brush.TextMuted}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveOrder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Активного заказа нет"
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                            <Button Content="Создать заказ"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource Button.Outline}"
                                    Command="{Binding CreateOrderCommand}"
                                    IsEnabled="{Binding HasSelectedTable}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
